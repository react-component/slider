{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "node",
    "baseUrl": "./",
    "jsx": "react",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["src/*"],
      "@@/*": ["src/.umi/*"],
      "@rc-component/slider": ["src/index.tsx"],
      "@rc-component/slider/es": ["src"],
      "@rc-component/slider/es/*": ["src/*"],
      "@rc-component/slider/assets/*": ["assets/*"]
    }
  },
  "include": [".dumirc.ts", "src", "tests", "docs/examples"],
  "exclude": ["docs-dist", "lib", "es"]
}
